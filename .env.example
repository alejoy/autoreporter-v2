# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/autoreporter

# AES-256-GCM — generá con: python3 -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=pon_aqui_64_caracteres_hex

# JWT — generá con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=pon_aqui_clave_secreta

# Usuario admin del panel
ADMIN_USER=admin
# Generá el hash con: python3 -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('tu-password'))"
ADMIN_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
